#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &five_col_layout; };
};

/ {
    behaviors {
        number_1_tilde: number_1_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_1_TILDE";
            bindings = <&kp KP_NUMBER_1>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_2_and: number_2_and {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_2_AND";
            bindings = <&kp KP_NUMBER_2>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_3_dollar: number_3_dollar {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_3_DOLLAR";
            bindings = <&kp KP_NUMBER_3>, <&kp DOLLAR>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_5_oe: number_5_oe {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_5_OE";
            bindings = <&kp KP_NUMBER_5>, <&oe>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_4_euro: number_4_euro {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_4_EURO";
            bindings = <&kp KP_NUMBER_4>, <&euro_sign>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_6_ue: number_6_ue {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_6_UE";
            bindings = <&kp KP_NUMBER_6>, <&ue>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_7_ae: number_7_ae {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_7_AE";
            bindings = <&kp KP_NUMBER_7>, <&ae>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_8_ss: number_8_ss {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_8_SS";
            bindings = <&kp KP_NUMBER_8>, <&ss>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        number_9_pipe: number_9_pipe {
            compatible = "zmk,behavior-mod-morph";
            label = "NUMBER_9_PIPE";
            bindings = <&kp KP_NUMBER_9>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        rot_rgb: rot_rgb {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ROT_RGB";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    macros {
        ue: ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp Y>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "UE";
        };

        oe: oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp P>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "OE";
        };

        ae: ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "AE";
        };

        ss: ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "SS";
        };

        euro_sign: euro_sign {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "EURO_SIGN";
        };

        vscode_terminal: vscode_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "VSCODE_TERMINAL";
        };

        vscode_navigate_back: vscode_navigate_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_ALT>;

            label = "VSCODE_NAVIGATE_BACK";
        };

        vscode_comment: vscode_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp SLASH>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "VSCODE_COMMENT";
        };

        vscode_editor: vscode_editor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "VSCODE_EDITOR";
        };

        vscode_copilot: vscode_copilot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp I>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_ALT>;

            label = "VSCODE_COPILOT";
        };

        vscode_function_hopping: vscode_function_hopping {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp DOT>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "VSCODE_FUNCTION_HOPPING";
        };

        vscode_search: vscode_search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "VSCODE_SEARCH";
        };

        vscode_navigate_forward: vscode_navigate_forward {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "VSCODE_NAVIGATE_FORWARD";
        };

        vscode_format: vscode_format {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LEFT_ALT>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LEFT_ALT>;

            label = "VSCODE_FORMAT";
        };

        vscode_close_windows: vscode_close_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp LEFT_CONTROL>,
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp W>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "VSCODE_CLOSE_WINDOWS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // ------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
  &kp Q             &kp W  &kp E         &kp R  &kp T                   &kp BACKSPACE  &mt K_MUTE PRINTSCREEN  &kp Y      &kp U  &kp I         &kp O      &kp P
  &kp A             &kp S  &kp D         &kp F  &kp G                   &lt 3 TAB      &msc SCRL_UP            &kp H      &kp J  &kp K         &kp L      &kp RIGHT_SHIFT
  &mt LEFT_SHIFT Z  &kp X  &kp C         &kp V  &kp B                                                          &kp N      &kp M  &kp COMMA     &lt 4 DOT  &kp DELETE
                           &kp LEFT_ALT  &mo 1  &mt LEFT_CONTROL SPACE                                         &kp ENTER  &mo 2  &kp LEFT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";

            // --------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |
            // | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
  &kp PERCENT    &trans    &kp UP_ARROW    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &kp K_MUTE  &kp ESCAPE  &number_7_ae     &number_8_ss     &number_9_pipe    &kp DELETE
  &kp BACKSLASH  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT             &kp AT_SIGN            &trans  &trans      &kp HOME    &number_4_euro   &number_5_oe     &number_6_ue      &trans
  &trans         &trans    &trans          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &kp END     &number_1_tilde  &number_2_and    &number_3_dollar  &trans
                           &trans          &trans                &trans                                     &trans      &trans           &kp KP_NUMBER_0
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  |
            // |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |
            // |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
  &kp EXCLAMATION  &kp QUESTION    &kp UP_ARROW      &kp POUND             &kp MINUS              &trans  &trans  &kp F1  &kp F2   &kp F3        &kp F4   &trans
  &kp SEMICOLON    &kp LEFT_ARROW  &kp DOWN          &kp RIGHT             &kp EQUAL              &trans  &trans  &kp F5  &kp F6   &kp F7        &kp F8   &trans
  &kp KP_DIVIDE    &kp ASTRK       &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp F9  &kp F10  &kp F11       &kp F12  &trans
                                   &trans            &trans                &trans                                 &trans  &trans   &kp LEFT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        settings {
            display-name = "settings";
            bindings = <
  &kp C_POWER  &none  &none  &none  &none  &none  &studio_unlock   &none           &none       &rgb_ug RGB_HUD                    &rgb_ug RGB_HUI                  &rgb_ug RGB_EFF
  &none        &none  &none  &none  &none  &none  &rgb_ug RGB_EFF  &bt BT_PRV      &bt BT_NXT  &rgb_ug RGB_COLOR_HSB(57,90,62)    &rgb_ug RGB_COLOR_HSB(0,100,51)  &rgb_ug RGB_TOG
  &none        &none  &none  &none  &none                          &bt BT_CLR_ALL  &bt BT_CLR  &rgb_ug RGB_COLOR_HSB(269,100,46)  &none                            &none
                      &none  &none  &none                          &none           &none       &none
            >;

            sensor-bindings = <&rot_rgb &rot_rgb &rot_rgb &rot_rgb>;
        };

        vs_code {
            display-name = "vs_code";
            bindings = <
  &none                  &kp F12         &vscode_navigate_back  &vscode_navigate_forward  &none                     &vscode_format  &none  &none  &none  &none  &none  &none
  &vscode_terminal       &vscode_editor  &vscode_copilot        &vscode_comment           &vscode_function_hopping  &none           &none  &none  &none  &none  &none  &none
  &vscode_close_windows  &none           &none                  &vscode_search            &kp F4                                           &none  &none  &none  &none  &none
                                         &none                  &none                     &none                                            &none  &none  &none
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
